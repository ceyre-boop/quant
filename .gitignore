# GOALS.md

# Trader control-layer ephemeral job statuses
data/agent/_jobs/

# L2 exit manager runtime state (shadow JSONL + state json) — never commit runtime state
data/exec/

# Sentiment board-state pipeline DuckDB (runtime data, rebuilt from sources) — never commit
data/sentiment.db
data/sentiment/

# Fundamentals harvest pipeline DuckDB (runtime data, rebuilt from sources) — never commit.
# data/cache/fundamentals/ is already covered by the broader data/cache/ rule above.
# data/fundamentals/ (the static JSON panel artifacts app/ reads) is NOT ignored — those
# are the committed "warm" tier, same pattern as the other data/*.json dashboards read.
data/fundamentals.db

# TICK-025: runtime DEGRADED sentinels (fail-loud yfinance/data-fetch fallback flags) — never commit
/sentinel/*
!/sentinel/.gitkeep
data/audit_cache/
data/research/gapper/cache/
data/research/yield_frontier/holdout_equities/grouped/
data/research/yield_frontier/holdout_equities/alpaca/
data/research/yield_frontier/holdout_equities/news/
data/research/yield_frontier/borrow_snapshots/
data/research/yield_frontier/halt_snapshots/
data/research/yield_frontier/shadow/

# Standalone dashboard — regenerated by scripts/build_standalone_dashboard.py (data baked in)
dashboard/dashboard_live.html

# Self-play training cycle checkpoints (large; spec §9)
data/training/

# MT5 bridge runtime data (TICK-056) — never commit routed orders, live unlock, or FOMC captures
data/execution/mt5_intents/*.json
data/execution/mt5_pending/*.json
data/execution/mt5_routed.jsonl
data/execution/mt5_LIVE_UNLOCK.json
data/execution/fomc_window_*.jsonl
!data/execution/mt5_intents/.gitkeep
!data/execution/mt5_pending/.gitkeep

# ICT causal journal — grows unbounded (per-scan re-emission); local-only, never in git
data/agent/ict_causal_chain.jsonl
node_modules

# Env backups — never commit (e.g. .env.bak.1784579534)
.env.bak*
.env.backup*

# Vite build output for GitHub Pages (built in CI, never committed)
_site/
app/node_modules/
app/dist/

# Harvester single-instance lock (runtime artifact)
data/fundamentals.harvest.lock
data/fundamentals.db
